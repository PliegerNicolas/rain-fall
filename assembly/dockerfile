FROM debian:bookworm-slim

ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        binutils \
        ca-certificates \
        file \
        gdb \
        libc6-i386 \
        procps \
        git \
        python3 \
        python3-pip \
        vim \
        wget \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --user --break-system-packages --no-cache-dir pwntools \
    && wget -q -O /root/.gdbinit-gef.py https://gef.blah.cat/py \
    && echo 'source /root/.gdbinit-gef.py' >> /root/.gdbinit

RUN mkdir -p /root/host-files

CMD ["tail", "-f", "/dev/null"]
